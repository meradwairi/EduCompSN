@model IEnumerable<EduCompSN_Clean.Models.ChatConversationViewModel>

@if (Model != null && Model.Any())
{
    foreach (var conv in Model)
    {
        <div class="conversation-item" data-userid="@conv.UserId" data-username="@conv.UserFullName" data-useremail="@conv.UserEmail">
            <div class="conversation-info">
                <strong>@conv.UserFullName</strong>
                @if (conv.UnreadCount > 0)
                {
                    <span class="unread-badge">@conv.UnreadCount</span>
                }
                <div class="last-message">@conv.LastMessage</div>
                <small class="message-time">@conv.LastMessageTime.ToString("dd/MM/yyyy HH:mm")</small>
            </div>
        </div>
    }
}
else
{
    <div class="no-conversations">⚠️ No conversations yet</div>
}