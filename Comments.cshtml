@model IEnumerable<EduCompSN_Clean.Models.Comment>

<h2>Manage Comments</h2>

<table class="table table-bordered">
    <thead><tr><th>Id</th><th>Post Id</th><th>User Id</th><th>Comment</th><th>Created At</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var comment in Model)
        {
            <tr>
                <td>@comment.Id</td>
                <td>@comment.PostId</td>
                <td>@comment.UserId</td>
                <td>@comment.Content</td>
                <td>@comment.CreatedAt</td>
                <td>
                    @using (Html.BeginForm("DeleteComment", "Admin", new { id = comment.Id }, FormMethod.Post))
                    {
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>