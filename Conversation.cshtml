@model IEnumerable<EduCompSN_Clean.Models.ChatMessage>

@{
    ViewBag.Title = "Chat";
    var withUser = ViewBag.WithUser as EduCompSN_Clean.Models.User;
    var currentUserId = (int)Session["UserId"];
}

<div class="container">
    <div class="row">
        <!-- القائمة الجانبية للمحادثات (اختياري) -->
        <div class="col-md-4">
            @Html.Action("ChatList", "Chat")
        </div>

        <!-- نافذة الدردشة -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5>Chat with @withUser.FullName</h5>
                </div>
                <div id="chatBox" class="card-body" style="height: 400px; overflow-y: scroll;">
                    @foreach (var msg in Model)
                    {
                        <div class="message @(msg.FromUserId == currentUserId ? "sent" : "received")">
                            <strong>@(msg.FromUserId == currentUserId ? "You" : withUser.FullName):</strong>
                            <p>@msg.Message</p>
                            <small>@msg.SentAt.ToString("HH:mm")</small>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <div class="input-group">
                        <input type="text" id="messageInput" class="form-control" placeholder="Type a message..." />
                        <button id="sendButton" class="btn btn-primary">Send</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .message {
        margin-bottom: 10px;
        padding: 5px 10px;
        border-radius: 10px;
        max-width: 80%;
        clear: both;
    }

        .message.sent {
            background-color: #dcf8c5;
            float: right;
            text-align: right;
        }

        .message.received {
            background-color: #f1f0f0;
            float: left;
            text-align: left;
        }

        .message p {
            margin: 0;
        }

        .message small {
            font-size: 0.7em;
            color: #888;
        }
</style>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <script src="~/signalr/hubs"></script>
    <script>
        $(function () {
            var chatHub = $.connection.chatHub;
            var currentUserId = '@Session["UserId"]';
            var withUserId = '@withUser.Id';
            var withUserFullName = '@withUser.FullName';

            // استقبال رسالة جديدة من الطرف الآخر
            chatHub.client.receivePrivateMessage = function (fromName, message) {
                if (fromName === withUserFullName) {
                    $('#chatBox').append('<div class="message received"><strong>' + withUserFullName + ':</strong><p>' + message + '</p><small>' + new Date().toLocaleTimeString() + '</small></div>');
                    $('#chatBox').scrollTop($('#chatBox')[0].scrollHeight);
                }
            };

            // بدء الاتصال بـ SignalR
            $.connection.hub.start().done(function () {
                $('#sendButton').click(function () {
                    var msg = $('#messageInput').val();
                    if (msg.trim() !== "") {
                        // إرسال الرسالة عبر SignalR (لتظهر فوراً للطرف الآخر)
                        chatHub.server.sendPrivateMessage(currentUserId, withUserId, msg);
                        // إضافة الرسالة إلى واجهتي (المرسل)
                        $('#chatBox').append('<div class="message sent"><strong>You:</strong><p>' + msg + '</p><small>' + new Date().toLocaleTimeString() + '</small></div>');
                        $('#messageInput').val('');
                        $('#chatBox').scrollTop($('#chatBox')[0].scrollHeight);

                        // حفظ الرسالة في قاعدة البيانات عبر AJAX
                        $.post('@Url.Action("SendMessage", "Chat")', { toUserId: withUserId, message: msg });
                    }
                });
            });
        });
    </script>
}