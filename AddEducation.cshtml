@model EduCompSN_Clean.Models.Education

@{
    ViewBag.Title = "Add Education";
}

<h2>Add Education</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(m => m.Degree)
        @Html.TextBoxFor(m => m.Degree, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Degree, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.FieldOfStudy)
        @Html.TextBoxFor(m => m.FieldOfStudy, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.FieldOfStudy, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Institution)
        @Html.TextBoxFor(m => m.Institution, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Institution, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.StartDate)
        @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.EndDate)
        @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Grade)
        @Html.TextBoxFor(m => m.Grade, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Grade, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
}