<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - EduCompSN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f3e8ff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .navbar {
            background-color: #8e44ad !important;
            border-radius: 15px;
            margin-top: 10px;
            padding: 5px 15px;
        }
        /* الشعار: أيقونة + نص - لون ليلكي وأكبر */
        .navbar-brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .graduation-icon {
            font-size: 2.5rem;
            color: #c39bd3;
        }

        .logo-text {
            font-size: 2rem;
            font-weight: bold;
            color: #c39bd3;
            letter-spacing: 1px;
        }

        .navbar-brand:hover .graduation-icon,
        .navbar-brand:hover .logo-text {
            color: #f3e8ff;
        }

        .nav-link {
            color: white !important;
            font-weight: 500;
            margin: 0 5px;
            border-radius: 50px;
            padding: 8px 18px;
            transition: all 0.2s;
        }

            .nav-link:hover {
                background-color: #6c3483;
                border-radius: 50px;
                transform: scale(1.02);
            }

        .footer {
            background-color: white;
            text-align: center;
            padding: 15px;
            margin-top: 30px;
            border-top: 1px solid #ddd;
            border-radius: 15px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <span class="graduation-icon">🎓</span>
                <span class="logo-text">EduCompSN</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home")">🏠 Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Posts")">📝 Posts</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Companies", "Members")">🏢 Companies</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Members", "Members")">👥 Members</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Chat")">💬 Chat</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("About", "Home")">ℹ️ About</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Contact", "Home")">📞 Contact</a></li>
                    @if (Session["UserId"] != null)
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Create", "Posts")">✨ New Post</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Profile")">👤 Profile</a></li>
                        <!-- رابط تسجيل الخروج -->
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Logout", "Account")" id="logoutLink">🚪 Logout</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Login", "Account")">🔐 Login</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Register", "Account")">📝 Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="footer">
        <div class="container">
            &copy; @DateTime.Now.Year - EduCompSN | Professional Network for Universities, Companies & Students
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)

    <!-- سكريبت تأكيد تسجيل الخروج -->
    <script>
        document.getElementById('logoutLink')?.addEventListener('click', function (e) {
            if (!confirm('Are you sure you want to logout?')) {
                e.preventDefault();
            }
        });
    </script>
</body>
</html>